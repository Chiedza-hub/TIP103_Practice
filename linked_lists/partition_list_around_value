class Node:
    def __init__(self, value, next=None):
        self.value = value
        self.next = next

# For testing
def print_linked_list(head):
    current = head
    while current:
        print(current.value, end=" -> " if current.next else "\n")
        current = current.next


def partition(head, val):
    smaller = Node(0)
    small_curr = smaller
    dummy = Node(0, head)
    prev = dummy
    curr = head
    
    while curr:
        next_node = curr.next
        if curr.value < val:
            prev.next = next_node # remove curr from original list
            curr.next = None # detach it
            small_curr.next = curr # append to smaller list
            small_curr = curr
        else:
            prev = curr # append to smaller list
        curr = next_node
        
    small_curr.next = dummy.next
    return smaller.next

head = Node(1, Node(4, Node(3, Node(2, Node(5, Node(2))))))

print_linked_list(partition(head, 3))

   